DB_PASSWORD=change-me-strong-password
JWT_KEY=change-me-to-a-random-secret-of-at-least-32-characters
APP_BASE_URL=https://boardroom.example.com
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# System Default Email Configuration (used when a company has hasCustomMail = false)
# Supported providers: SMTP | Mailgun | SendGrid | Brevo
# For local development with Mailpit/MailHog on your host machine, use:
# SMTP_HOST=host.docker.internal, SMTP_PORT=1025, and leave username/password blank if unauthenticated.
MAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=smtp-secure-password
SMTP_FROM_ADDRESS=notifications@example.com
SMTP_FROM_NAME=BoardRoom

